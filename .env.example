# WindSight Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend Configuration (Docker Compose overrides DB_PATH to /data/windsight.db)
DB_PATH=./windsight.db
FLASK_DEBUG=false
PYTHONUNBUFFERED=1

# Elexon API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT=30
ELEXON_MAX_RETRIES=3
ELEXON_MAX_CONCURRENCY=6

# Decision Cutoff Configuration (UK time)
# The procurement decision cutoff for day-ahead market
DECISION_CUTOFF_HOUR=11
DECISION_CUTOFF_MINUTE=0
DECISION_CUTOFF_TIMEZONE=Europe/London

# MAPE Calculation
MAPE_EXCLUSION_THRESHOLD=1.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Configuration (development only; production uses the same-origin /api proxy)
VITE_API_BASE=http://localhost:5000/api